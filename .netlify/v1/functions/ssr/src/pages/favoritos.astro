---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
    <h1 class="section-title">❤️ Mi lista</h1>

    <div class="movies-grid fixed-grid" id="favoritesGrid"></div>

    <script>
        const favoritesGrid = document.getElementById(
            "favoritesGrid",
        ) as HTMLDivElement;

        let favoritos: Favorito[] = JSON.parse(
            localStorage.getItem("favoritos") || "[]",
        );

        /* NO HAY FAVORITOS */

        if (favoritos.length === 0) {
            favoritesGrid.innerHTML = `

            <div class="empty-favorites">

                <h2>
                    No tienes películas guardadas ❤️
                </h2>

                <p>
                    Añade películas desde el botón
                    "Añadir a favoritos"
                </p>

            </div>`;
        }

        /* MOSTRAR FAVORITOS */

        interface Favorito {
            id: string;
            title: string;
            poster: string;
        }

        favoritos.forEach((pelicula) => {
            favoritesGrid.innerHTML += `

            <div class="movie-card">

                <img
                    src="https://image.tmdb.org/t/p/w500${pelicula.poster}"
                >

                <div class="movie-card-content">

                    <h3>${pelicula.title}</h3>

                    <div class="movie-buttons">

                        <a
                            href="/pelicula/${pelicula.id}"
                            class="info-button"
                        >
                            Ver info
                        </a>

                        <button
                            class="remove-favorite-button"
                            data-id="${pelicula.id}"
                        >
                            ❌ Eliminar
                        </button>

                    </div>

                </div>

            </div>`;
        });

        /* ELIMINAR FAVORITOS */

        document.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;

            if (target.classList.contains("remove-favorite-button")) {
                const id = target.dataset.id;

                favoritos = favoritos.filter((fav) => fav.id !== id);

                localStorage.setItem("favoritos", JSON.stringify(favoritos));

                location.reload();
            }
        });
    </script>
</MainLayout>
