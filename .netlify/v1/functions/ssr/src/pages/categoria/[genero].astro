---
/*
=================================
[GENERO].ASTRO
=================================

Página dinámica de categorías.

Funciones:
- Obtener el género seleccionado desde
  la URL.
- Consultar TMDB para obtener películas
  del género correspondiente.
- Mostrar resultados paginados.
- Mostrar tarjetas de películas con
  estilo Netflix.
- Permitir acceder al detalle de cada
  película.
- Permitir reproducir una película
  mediante el modal de streaming.
- Mostrar el indicador de favoritos ❤️
  para las películas guardadas en
  Mi Lista.

Utiliza:
- MainLayout.astro
- TMDB API
- LocalStorage (favoritos)
*/

export const prerender = false;
import MainLayout from "../../layouts/MainLayout.astro";

const genero = Astro.params.genero;
const genreId = Astro.url.searchParams.get("id");
const currentPage =
    Number(Astro.url.searchParams.get("page")) || 1;

const API_KEY = import.meta.env.PUBLIC_TMDB_API_KEY;

interface Pelicula {
    id: number;
    title: string;
    poster_path: string;
    overview: string;
    vote_average: number;
    release_date: string;
}

const response = await fetch(
    `https://api.themoviedb.org/3/discover/movie?api_key=${API_KEY}&with_genres=${genreId}&language=es-ES&page=${currentPage}`
);

const data = await response.json();
const peliculas: Pelicula[] = data.results;
const totalPages = data.total_pages;
---

<MainLayout>

    <a href="/" class="back-button">
        ⬅ Volver al inicio
    </a>

    <h1 class="section-title">
        Categoría: {genero}
    </h1>

    <div class="movies-grid">

    {
        peliculas.map((pelicula) => (

            <div class="movie-card mobile-click-card">

                <div class="movie-image-container">

                    <!-- INDICADOR FAVORITOS -->
                    <div
                        class="favorite-indicator"
                        data-movie-id={pelicula.id}
                    >
                        ❤️
                    </div>

                    <img
                        src={`https://image.tmdb.org/t/p/w500${pelicula.poster_path}`}
                        alt={pelicula.title}
                    />

                    <!-- OVERLAY -->
                    <div class="movie-overlay">

                        <div class="overlay-content">

                            <h3>{pelicula.title}</h3>

                            <div class="overlay-info">

                                <span>
                                    ⭐ {pelicula.vote_average.toFixed(1)}
                                </span>

                                <span>
                                    📅 {pelicula.release_date}
                                </span>

                            </div>

                            <p class="overlay-description">

                                {
                                    pelicula.overview?.slice(0, 120)
                                }...

                            </p>

                            <div class="movie-buttons">

                                <a
                                    href={`/pelicula/${pelicula.id}`}
                                    class="info-button"
                                >
                                    Ver info
                                </a>

                                <a
                                    href={`/pelicula/${pelicula.id}?autoplay=true`}
                                    class="watch-button"
                                >
                                    ▶ Ver
                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        ))
    }

    </div>

    <!-- PAGINACIÓN -->

    <div class="pagination">

        {
            currentPage > 1 && (

                <a
                    href={`/categoria/${genero}?id=${genreId}&page=${currentPage - 1}`}
                    class="page-button"
                >
                    ⬅ Anterior
                </a>

            )
        }

        <p>
            Página {currentPage} de {totalPages}
        </p>

        {
            currentPage < totalPages && (

                <a
                    href={`/categoria/${genero}?id=${genreId}&page=${currentPage + 1}`}
                    class="page-button"
                >
                    Siguiente ➡
                </a>

            )
        }

    </div>

    <script>

        interface Favorito {
            id: number;
        }

        const favoritos: Favorito[] =
            JSON.parse(
                localStorage.getItem("favoritos") || "[]"
            );

        document
            .querySelectorAll<HTMLElement>(".favorite-indicator")
            .forEach((heart) => {

            const id =
            Number(heart.dataset.movieId);

            const existe =
                favoritos.some(
                    fav => fav.id == id
                );

            if(existe){

                heart.style.display = "flex";

            }

        });

    </script>

</MainLayout>