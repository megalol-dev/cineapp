---
/*
=================================================
PÁGINA DE BÚSQUEDA DE PELÍCULAS
=================================================

Funciones:
- Recibir el texto introducido por el usuario.
- Realizar búsquedas en la API de TMDB.
- Mostrar los resultados encontrados.
- Mostrar información básica de cada película:
  título, póster, valoración y fecha de estreno.
- Permitir acceder a la ficha completa de cada película.
- Indicar visualmente si una película está añadida
  a favoritos.

Datos utilizados:
- API The Movie Database (TMDB).
- Parámetro de búsqueda introducido por el usuario.

Utiliza:
- MainLayout.astro
- global.css

Rutas relacionadas:
- /
- /pelicula/[id]

=================================================
*/
export const prerender = false;

import MainLayout from "../layouts/MainLayout.astro";

const query = Astro.url.searchParams.get("q");

/* ============================= */
/* INTERFACES */
/* ============================= */
interface PeliculaBusqueda {
    id: number;
    title: string;
    poster_path: string;
    overview: string;
    vote_average: number;
    release_date: string;
}


const API_KEY = import.meta.env.PUBLIC_TMDB_API_KEY;

let peliculas: PeliculaBusqueda[] = [];

if(query){

    const response = await fetch(
        `https://api.themoviedb.org/3/search/movie?api_key=${API_KEY}&query=${query}&language=es-ES`
    );

    const data = await response.json();

    peliculas = data.results;

}
---

<MainLayout>

    <a href="/" class="back-button">
        ⬅ Volver al inicio
    </a>

    <h1 class="section-title">
        Resultados para: "{query}"
    </h1>

    <div class="movies-grid">

        {
            peliculas.map((pelicula) => (

                <div class="movie-card mobile-click-card">

                    <div class="movie-image-container">

                        <!-- IMG AÑADIDO A FAVORITOS -->

                        <div
                        class="favorite-indicator"
                        data-movie-id={pelicula.id}
                        >
                        ❤️
                        </div>

                        <img
                            src={`https://image.tmdb.org/t/p/w500${pelicula.poster_path}`}
                            alt={pelicula.title}
                        />

                        <!-- OVERLAY -->

                        <div class="movie-overlay">

                            <div class="overlay-content">

                                <h3>{pelicula.title}</h3>

                                <div class="overlay-info">

                                    <span>
                                        ⭐ {pelicula.vote_average.toFixed(1)}
                                    </span>

                                    <span>
                                        📅 {pelicula.release_date}
                                    </span>

                                </div>

                                <p class="overlay-description">

                                    {
                                        pelicula.overview
                                        ?.slice(0,120)
                                    }...

                                </p>

                                <div class="movie-buttons">

                                    <a
                                        href={`/pelicula/${pelicula.id}`}
                                        class="info-button"
                                    >
                                        Ver info
                                    </a>

                                    <a
                                        href={`/pelicula/${pelicula.id}?autoplay=true`}
                                        class="watch-button"
                                    >
                                        ▶ Ver
                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            ))
        }

    </div>

    <script>

        interface Favorito {
        id: string;
        }

        const favoritos: Favorito[] = JSON.parse(
        localStorage.getItem("favoritos") || "[]"
        );

        document
        .querySelectorAll<HTMLElement>(".favorite-indicator")
        .forEach((heart) => {
        
            const id =
                heart.dataset.movieId;

            const existe =
                favoritos.some(
                    fav => fav.id == id
                );

            if(existe){
                heart.style.display = "flex";
            }

        });

    </script>

</MainLayout>