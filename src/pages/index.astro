---
/*
=================================================
PÁGINA PRINCIPAL DE LA APLICACIÓN (HOME)
=================================================

Funciones:
- Mostrar el Hero principal con el Top 10 de películas.
- Obtener datos desde la API de TMDB.
- Mostrar películas destacadas por categorías.
- Mostrar secciones de Acción, Comedia, Terror,
  Drama, Ciencia Ficción y Animación.
- Cargar componentes reutilizables de películas.
- Servir como página de inicio de la aplicación.

Datos utilizados:
- API The Movie Database (TMDB).
- Rankings de películas más populares.
- Películas mejor valoradas por género.

Utiliza:
- MainLayout.astro
- HomeMovieCard.astro
- CategoryCard.astro

Rutas relacionadas:
- /pelicula/[id]
- /categoria/[genero]

=================================================
*/
import MainLayout from "../layouts/MainLayout.astro";
import HomeMovieCard from "../components/HomeMovieCard.astro";

/* ============================= */
/* INTERFACES */
/* ============================= */
interface HeroPelicula {
    id: number;
    title: string;
    overview: string;
    backdrop_path: string;
    vote_average: number;
    vote_count: number;
    release_date: string;
}

const API_KEY = import.meta.env.PUBLIC_TMDB_API_KEY;

/* ============================= */
/* TOP 10 PELÍCULAS TENDENCIA */
/* ============================= */

const response = await fetch(
    `https://api.themoviedb.org/3/trending/movie/week?api_key=${API_KEY}&language=es-ES`,
);

const data = await response.json();

const topPeliculas: HeroPelicula[] = data.results.slice(0, 10);

/* ============================= */
/* TOP PELÍCULAS POR CATEGORÍA */
/* ============================= */

async function obtenerGenero(id: number) {
    const response = await fetch(
        `https://api.themoviedb.org/3/discover/movie?api_key=${API_KEY}&with_genres=${id}&sort_by=vote_average.desc&vote_count.gte=1000&language=es-ES`,
    );

    const data = await response.json();

    return data.results.slice(0, 5);
}

const accion: HeroPelicula[] = await obtenerGenero(28);
const comedia: HeroPelicula[] = await obtenerGenero(35);
const terror: HeroPelicula[] = await obtenerGenero(27);
const drama: HeroPelicula[] = await obtenerGenero(18);
const cienciaFiccion: HeroPelicula[] = await obtenerGenero(878);
const animacion: HeroPelicula[] = await obtenerGenero(16);
---

<MainLayout>
    <!-- ============================= -->
    <!-- HERO TOP 10 -->
    <!-- ============================= -->

    <section class="hero-slider">
        {
            topPeliculas.map((pelicula, index: number) => (
                <div
                    class={`hero-slide ${index === 0 ? "active-slide" : ""}`}
                    style={`background-image:url(https://image.tmdb.org/t/p/original${pelicula.backdrop_path})`}
                >
                    <div class="hero-overlay">
                        <div class="hero-content">
                            <span class="hero-rank">
                                🔥 TOP #{index + 1} DEL MOMENTO
                            </span>

                            <h1>{pelicula.title}</h1>

                            <p>{pelicula.overview}</p>

                            <div class="hero-stats">
                                <span>
                                    ⭐ {pelicula.vote_average.toFixed(1)}
                                </span>

                                <span>🌍 Trending mundial</span>

                                <span>👥 {pelicula.vote_count} votos</span>

                                <span>📅 {pelicula.release_date}</span>
                            </div>

                            <div class="hero-buttons">
                                <a
                                    href={`/pelicula/${pelicula.id}`}
                                    class="hero-info-btn"
                                >
                                    Ver información
                                </a>

                                <a
                                    href={`/pelicula/${pelicula.id}?autoplay=true`}
                                    class="hero-watch-btn"
                                >
                                    ▶ Ver película
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            ))
        }
    </section>

    <!-- ============================= -->
    <!-- BUSCADOR GLOBAL -->
    <!-- ============================= -->

    <section class="home-search-section">
        <h2>Encuentra cualquier película</h2>

        <div class="search-container">
            <form action="/busqueda" method="GET" id="search-form">
                <input
                    type="text"
                    name="q"
                    id="search-input"
                    placeholder="Buscar película..."
                />

                <button type="submit"> Buscar </button>
            </form>
        </div>
    </section>

    <!-- ============================= -->
    <!-- TOP POR CATEGORÍAS -->
    <!-- ============================= -->

    <section class="home-categories">
        <!-- ACCIÓN -->

        <div class="category-row">
            <h2>🔥 Acción</h2>

            <div class="movies-grid">
                {
                    accion.map((pelicula) => (
                        <HomeMovieCard pelicula={pelicula} />
                    ))
                }
            </div>
        </div>

        <!-- COMEDIA -->

        <div class="category-row">
            <h2>😂 Comedia</h2>

            <div class="movies-grid">
                {
                    comedia.map((pelicula) => (
                        <HomeMovieCard pelicula={pelicula} />
                    ))
                }
            </div>
        </div>

        <!-- TERROR -->

        <div class="category-row">
            <h2>😱 Terror</h2>

            <div class="movies-grid">
                {
                    terror.map((pelicula) => (
                        <HomeMovieCard pelicula={pelicula} />
                    ))
                }
            </div>
        </div>

        <!-- DRAMA -->

        <div class="category-row">
            <h2>🎭 Drama</h2>

            <div class="movies-grid">
                {drama.map((pelicula) => <HomeMovieCard pelicula={pelicula} />)}
            </div>
        </div>

        <!-- CIENCIA FICCIÓN -->

        <div class="category-row">
            <h2>🚀 Ciencia ficción</h2>

            <div class="movies-grid">
                {
                    cienciaFiccion.map((pelicula) => (
                        <HomeMovieCard pelicula={pelicula} />
                    ))
                }
            </div>
        </div>

        <!-- ANIMACIÓN -->

        <div class="category-row">
            <h2>🎌 Animación</h2>

            <div class="movies-grid">
                {
                    animacion.map((pelicula) => (
                        <HomeMovieCard pelicula={pelicula} />
                    ))
                }
            </div>
        </div>
    </section>

    <script>
        const slides = document.querySelectorAll(".hero-slide");
        let currentSlide = 0;

        function cambiarSlide() {
            slides[currentSlide].classList.remove("active-slide");

            currentSlide++;

            if (currentSlide >= slides.length) {
                currentSlide = 0;
            }

            slides[currentSlide].classList.add("active-slide");
        }

        setInterval(cambiarSlide, 6000);

        /* FAVORITOS */
        /*--------------------------------------------------------------*/
        interface Favorito {
            id: string;
        }

        const favoritos: Favorito[] = JSON.parse(
            localStorage.getItem("favoritos") || "[]",
        );

        document
            .querySelectorAll<HTMLElement>(".favorite-indicator")
            .forEach((heart) => {
                const id = heart.dataset.movieId;

                const existe = favoritos.some((fav) => fav.id === id);

                if (existe) {
                    heart.style.display = "flex";
                }
            });

        /* BUCAR PELICULA */
        /*--------------------------------------------------------------*/
        const form = document.getElementById("search-form");
        const input = document.getElementById("search-input");
        const error = document.getElementById("search-error");

        form?.addEventListener("submit", (e) => {
            if (!(input instanceof HTMLInputElement)) {
                return;
            }

            if (!input.value.trim()) {
                e.preventDefault();
                input.value = "⚠ Escribe una película";

                input.style.color = "red";
            }

            input.addEventListener("focus", () => {
                if (input.value === "⚠ Escribe una película antes de buscar") {
                    input.value = "";

                    input.style.color = "";
                }
            });
        });
    </script>
    
</MainLayout>
