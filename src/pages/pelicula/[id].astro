---
/* 
[id].astro

Página dinámica de detalle de película.

Funciones:
- Obtener el ID de la película desde la URL.
- Consultar la API de TMDB para cargar la información completa.
- Mostrar:
    - Título
    - Portada
    - Sinopsis
    - Géneros
    - Duración
    - Valoración
    - Fecha de estreno
- Mostrar el tráiler oficial de YouTube si existe.
- Mostrar películas similares recomendadas.
- Gestionar favoritos mediante LocalStorage.
- Mostrar notificaciones (toast) al añadir favoritos.
- Gestionar el modal de reproducción.
- Permitir reproducción automática mediante el parámetro ?autoplay=true.

Utilizado por:
- Enlaces de películas desde:
    - Inicio
    - Categorías
    - Buscador
    - Favoritos
    - Recomendaciones similares
*/
export const prerender = false;
import MainLayout from "../../layouts/MainLayout.astro";

/* =========================
   INTERFACES API TMDB
   Modelan los datos recibidos
   desde The Movie Database.
========================= */

interface Video {
    type: string;
    site: string;
    key: string;
}

interface Genero {
    id: number;
    name: string;
}

interface PeliculaSimilar {
    id: number;
    title: string;
    poster_path: string;
}

/* =========================
   CONFIGURACIÓN
========================= */

const API_KEY = import.meta.env.PUBLIC_TMDB_API_KEY;
const id = Astro.params.id;
const autoplay = Astro.url.searchParams.get("autoplay");

/* =========================
   DETALLE PELÍCULA
========================= */

const response = await fetch(
    `https://api.themoviedb.org/3/movie/${id}?api_key=${API_KEY}&language=es-ES&append_to_response=videos`,
);

const pelicula = await response.json();

/* =========================
   TRAILER
========================= */

const trailer = pelicula.videos.results.find(
    (video: Video) => video.type === "Trailer" && video.site === "YouTube",
);

/* =========================
   PELÍCULAS SIMILARES
========================= */

const similarResponse = await fetch(
    `https://api.themoviedb.org/3/movie/${id}/similar?api_key=${API_KEY}&language=es-ES&page=1`,
);

const similarData = await similarResponse.json();
const similares = similarData.results.slice(0, 6);
---

<MainLayout>
    <a href="javascript:history.back()" class="back-button"> ⬅ Volver atrás </a>

    <section class="movie-hero-detail">
        <div class="movie-poster-box">
            <img
                src={`https://image.tmdb.org/t/p/w500${pelicula.poster_path}`}
                alt={pelicula.title}
            />
        </div>

        <div class="movie-info">
            <span class="movie-tag">Película</span>

            <h1>{pelicula.title}</h1>

            <p class="movie-overview">
                {pelicula.overview}
            </p>

            <div class="movie-meta">
                <span>
                    ⭐ {pelicula.vote_average.toFixed(1)}
                </span>

                <span>
                    📅 {pelicula.release_date}
                </span>

                <span>
                    ⏱️ {pelicula.runtime} min
                </span>
            </div>

            <p>
                <strong>Géneros:</strong>
                {pelicula.genres.map((g: Genero) => g.name).join(", ")}
            </p>

            <div class="detail-buttons">
                <button class="watch-button large-watch-button" id="openModal">
                    ▶ Ver película
                </button>

                <button
                    class="favorite-button"
                    id="favoriteBtn"
                    data-id={pelicula.id}
                    data-title={pelicula.title}
                    data-poster={pelicula.poster_path}
                >
                    ❤️ Añadir a mi lista
                </button>
            </div>
        </div>
    </section>

    <!-- TRAILER -->

    {
        trailer ? (
            <section class="trailer-section">
                <h2>Trailer oficial</h2>

                <div class="trailer-container">
                    <iframe
                        src={`https://www.youtube.com/embed/${trailer.key}`}
                        title={`Trailer de ${pelicula.title}`}
                        allowfullscreen
                    />
                </div>
            </section>
        ) : (
            <p class="no-trailer">No hay trailer disponible.</p>
        )
    }

    <!-- PELÍCULAS SIMILARES -->

    <section class="similar-section">
        <h2>🔥 También te puede gustar</h2>

        <div class="movies-grid">
            {
                similares.map((peliculaSimilar: PeliculaSimilar) => (
                    <a
                        href={`/pelicula/${peliculaSimilar.id}`}
                        class="movie-card"
                    >
                        <img
                            src={`https://image.tmdb.org/t/p/w500${peliculaSimilar.poster_path}`}
                            alt={peliculaSimilar.title}
                        />
                    </a>
                ))
            }
        </div>
    </section>

    <!-- MODAL STREAMING -->

    <div class="movie-modal" id="movieModal">
        <div class="movie-modal-content">
            <button class="close-modal" id="closeModal"> ✖ </button>

            <div class="modal-video">
                {
                    trailer ? (
                        <iframe
                            src={`https://www.youtube.com/embed/${trailer.key}?autoplay=1`}
                            title={`Trailer de ${pelicula.title}`}
                            allowfullscreen
                        />
                    ) : (
                        <div class="fake-player">
                            <h2>🎬 Próximamente</h2>

                            <p>
                                Esta película aún no está disponible en
                                streaming.
                            </p>
                        </div>
                    )
                }
            </div>
        </div>
    </div>

    <!-- TOAST -->

    <div class="toast" id="toast">❤️ Película añadida a Mi Lista</div>

    <script>
        /* =========================
        INTERFACES CLIENTE
        Modelan los datos guardados
        en localStorage del navegador.
        ========================= */
        interface Favorito {
            id: string;
            title: string;
            poster: string;
        }

        /* FAVORITOS */
        const favoriteBtn = document.getElementById(
            "favoriteBtn",
        ) as HTMLButtonElement;

        const favoritos: Favorito[] = JSON.parse(
            localStorage.getItem("favoritos") || "[]",
        );

        const yaExiste = favoritos.some(
            (fav) => fav.id === favoriteBtn.dataset.id,
        );

        if (yaExiste) {
            favoriteBtn.textContent = "✅ En tu lista";
            favoriteBtn.disabled = true;
            favoriteBtn.classList.add("favorite-added");
        }

        const toast = document.getElementById("toast") as HTMLDivElement;

        favoriteBtn.addEventListener("click", () => {
            const pelicula: Favorito = {
                id: favoriteBtn.dataset.id!,
                title: favoriteBtn.dataset.title!,
                poster: favoriteBtn.dataset.poster!,
            };

            let favoritos: Favorito[] = JSON.parse(
                localStorage.getItem("favoritos") || "[]",
            );

            const existe = favoritos.some((fav) => fav.id === pelicula.id);

            if (existe) {
                showToast("⚠️ Ya está en tu lista");

                return;
            }

            favoritos.push(pelicula);
            localStorage.setItem("favoritos", JSON.stringify(favoritos));

            favoriteBtn.textContent = "✅ En tu lista";
            favoriteBtn.disabled = true;
            favoriteBtn.classList.add("favorite-added");

            showToast("❤️ Añadida a Mi Lista");
        });

        /* TOAST */
        function showToast(text: string) {
            toast.textContent = text;

            toast.classList.add("show-toast");

            setTimeout(() => {
                toast.classList.remove("show-toast");
            }, 2500);
        }

        /* MODAL STREAMING */
        const modal =
            document.getElementById("movieModal")as HTMLDivElement;

        const openModal =
            document.getElementById("openModal")as HTMLButtonElement;

        const closeModal =
            document.getElementById("closeModal")as HTMLButtonElement;

        /* AUTOPLAY */
            if (window.location.search.includes("autoplay=true")) {
            modal.classList.add("active");

            document.body.style.overflow = "hidden";
        }

        /* ABRIR */

        openModal.addEventListener("click", () => {
            modal.classList.add("active");

            document.body.style.overflow = "hidden";
        });

        /* CERRAR */

        closeModal.addEventListener("click", () => {
            modal.classList.remove("active");

            document.body.style.overflow = "auto";
        });

        /* CLICK FUERA */

        modal.addEventListener("click", (e) => {
            if (e.target === modal) {
                modal.classList.remove("active");

                document.body.style.overflow = "auto";
            }
        });
    </script>
    
</MainLayout>
